# ===== Judge / 评测用模型（必填，仅评测打分用）=====
HY3_API_KEY=sk-your-key-here
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_MODEL=hy3
HY3_TIMEOUT=120

# 可指定与被测系统不同的 judge 模型（不填则复用 HY3_MODEL）
# JUDGE_MODEL=hy3

# ===== Studio adapter（被测系统 Hy3 Research Studio 的位置）=====
# 不填时自动向上查找 ../Hy3-Research-Studio
# STUDIO_ROOT=../Hy3-Research-Studio

# ===== 可选：openai_compat adapter 用其他模型做跨系统对照 =====
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
